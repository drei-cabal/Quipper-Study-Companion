{
  "manifest_version": 3,
  "name": "Quipper Study Helper",
  "description": "Reads visible question text and provides study hints and choice explanations without selecting answers.",
  "version": "0.1.0",
  "action": {
    "default_title": "Study Helper"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://*.quipper.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.quipper.com/*"
      ],
      "js": [
        "src/shared/messages.js",
        "src/content/text-utils.js",
        "src/content/dom-blocks.js",
        "src/content/layout-extractors.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
